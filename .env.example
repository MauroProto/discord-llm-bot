# === DISCORD ===
# Bot token (obtenido del Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Prefijo de comandos (default: !)
BOT_PREFIX=!

# ID del servidor/guild donde el bot funciona (solo ahi responde)
# Sacarlo en Discord: clic derecho en el servidor > Copiar ID del servidor
ALLOWED_GUILD_ID=your_server_id_here

# ID del canal donde el bot funciona (opcional, si no se pone responde en todos los canales del servidor)
# Sacarlo en Discord: clic derecho en el canal > Copiar ID del canal
ALLOWED_CHANNEL_ID=your_channel_id_here

# === ANTHROPIC / CLAUDE ===
# API key (obtenida de https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modelo de Claude a usar
# Opciones populares:
#   claude-opus-4-7               (recomendado, maxima calidad, soporta 1M context)
#   claude-sonnet-4-6             (balance calidad/velocidad/costo)
#   claude-haiku-4-5              (mas rapido, mas barato)
ANTHROPIC_MODEL=claude-opus-4-7

# Activa la ventana de 1M tokens (beta context-1m-2025-08-07)
# Solo soportado por Opus/Sonnet 4.x; ponelo en false si usas Haiku.
ENABLE_1M_CONTEXT=true

# Razonamiento extendido — adaptive thinking de Opus 4.7
# Niveles de esfuerzo: low, medium, high, xhigh, max
EXTENDED_THINKING=true
THINKING_EFFORT=max

# Max tokens por respuesta (output + thinking). Debe ser > THINKING_BUDGET_TOKENS
MAX_TOKENS=32000

# === CONTEXTO / ALMACENAMIENTO ===
# Directorio donde se guardan los archivos .md con el historial
DATA_DIR=./data

# Cantidad de mensajes de historial que lee el bot (default: 100)
HISTORY_LIMIT=100

# === BUSQUEDA WEB (opcional, fallback) ===
# Tavily API key (https://tavily.com, gratis hasta 1000 llamadas/mes)
TAVILY_API_KEY=your_tavily_key_here

# SerpAPI key (https://serpapi.com, gratis hasta 100 llamadas/mes)
SERPAPI_KEY=your_serpapi_key_here

# === RESPUESTAS ESPONTANEAS (desactivado por default) ===
# Si es true, el bot responde sin ser mencionado cuando detecta palabras clave
SPONTANEOUS_RESPONSE=false

# Probabilidad de respuesta espontanea (0.0 a 1.0)
SPONTANEOUS_PROBABILITY=0.3

# === PERSONALIDAD (opcional) ===
# Si queres cambiar la personalidad de Lain, pega aca tu propio system prompt
# Si lo dejas vacio, usa la personalidad default de Lain (divertida, directa, sin filtro)
# SYSTEM_PROMPT=

# === VOZ (ElevenLabs TTS + STT) ===
# Master switch — true para habilitar comandos !join/!leave y voz
VOICE_ENABLED=false

# (Opcional) ID del canal de voz por defecto.
# Si lo seteás, !join se conecta SIEMPRE a este canal sin importar dónde estés.
# Si lo dejás vacío, !join usa el VC donde vos estés conectado.
# Sacarlo: clic derecho en el canal de voz → Copiar ID
# VOICE_CHANNEL_ID=

# API key de ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID de ElevenLabs (https://elevenlabs.io/app/voice-library)
# Default: AwmgI32PB22lsT7wnBFH
ELEVENLABS_VOICE_ID=AwmgI32PB22lsT7wnBFH

# Modelo TTS:
#   eleven_v3              (el más expresivo y natural; latencia un poco mayor)
#   eleven_turbo_v2_5      (balance calidad/latencia ~300ms, multilingüe)
#   eleven_flash_v2_5      (ultra baja latencia ~75ms, calidad menor)
#   eleven_multilingual_v2 (alta calidad, latencia ~1-2s)
ELEVENLABS_TTS_MODEL=eleven_v3

# Modelo STT (Scribe)
ELEVENLABS_STT_MODEL=scribe_v1

# Idioma para STT (ISO-639-3): spa=español, eng=inglés, por=portugués, etc.
VOICE_LANGUAGE=spa

# Si true, Lain participa de toda la charla del VC sin esperar wake word
VOICE_ALWAYS_RESPOND=true

# Wake words (CSV) — solo se usan si VOICE_ALWAYS_RESPOND=false
VOICE_WAKE_WORDS=lain

# Filtros anti-ruido y anti-atropello
VOICE_MIN_TURN_CHARS=3
VOICE_COOLDOWN_MS=1500
VOICE_SILENCE_MS=800
VOICE_MAX_TURN_SECONDS=30

# Si está en VC, leer también respuestas que da en el chat de texto
VOICE_MIRROR_TEXT=false

# Truncar respuestas TTS más largas que esto (chars)
VOICE_MAX_RESPONSE_CHARS=600

# Cuántos turnos recientes de voz inyectar como contexto inmediato a Claude
VOICE_RECENT_TURNS=30

# === Razonamiento Claude en VOZ (independiente del chat) ===
# El chat normal sigue usando EXTENDED_THINKING / THINKING_EFFORT (max).
# En voz queremos respuestas inmediatas → razonamiento bajo o apagado.
VOICE_EXTENDED_THINKING=false
VOICE_THINKING_EFFORT=low

# === Voice settings (cómo suena la voz) ===
# speed: 1.0 normal, <1 más pausada, >1 más rápida. 0.88-0.95 = charla natural.
VOICE_SPEED=0.92
# stability: 0-1. Más alto = más consistente; más bajo = más expresivo.
VOICE_STABILITY=0.5
# similarity_boost: 0-1. Cuán fielmente sigue el timbre original.
VOICE_SIMILARITY_BOOST=0.8
# style: 0-1. Un poco de estilo ayuda a sonar natural.
VOICE_STYLE=0.15
VOICE_USE_SPEAKER_BOOST=true
