# ============================================================================
# Lain Discord Bot — example environment configuration
# Copy this file to .env and fill in your values.
# ============================================================================

# ───────────────────────────────────────────────────────────────
# Discord
# ───────────────────────────────────────────────────────────────

# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Command prefix (default: !)
BOT_PREFIX=!

# Restrict the bot to one server. Right-click your server icon → Copy Server ID
# (requires Developer Mode enabled in Discord settings).
ALLOWED_GUILD_ID=your_server_id_here

# Restrict the bot to one text channel (optional). If empty, replies in any
# channel of the allowed guild. Right-click the channel → Copy Channel ID.
ALLOWED_CHANNEL_ID=your_channel_id_here


# ───────────────────────────────────────────────────────────────
# Anthropic / Claude
# ───────────────────────────────────────────────────────────────

# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model used for text chat. Options:
#   claude-opus-4-7    — highest quality, supports 1M context
#   claude-sonnet-4-6  — balanced quality / speed / cost
#   claude-haiku-4-5   — fastest, cheapest
ANTHROPIC_MODEL=claude-opus-4-7

# 1M context window beta. Only Opus/Sonnet 4.x. Set to false for Haiku.
ENABLE_1M_CONTEXT=true

# Adaptive extended thinking. Effort levels: low | medium | high | xhigh | max
EXTENDED_THINKING=true
THINKING_EFFORT=max

# Max tokens per response (output + thinking).
MAX_TOKENS=32000


# ───────────────────────────────────────────────────────────────
# Context / Storage
# ───────────────────────────────────────────────────────────────

# Where to store the daily .md context files (mount as a volume in production).
DATA_DIR=./data

# Number of Discord messages to fetch as recent history.
HISTORY_LIMIT=100

# Long-term memory: how many days of saved .md context to inject as background.
MEMORY_DAYS=14
MEMORY_MAX_CHARS=400000


# ───────────────────────────────────────────────────────────────
# Web search fallback (optional)
# ───────────────────────────────────────────────────────────────

# Tavily API key (https://tavily.com — free 1000 calls/month)
TAVILY_API_KEY=

# SerpAPI key (https://serpapi.com — free 100 calls/month)
SERPAPI_KEY=


# ───────────────────────────────────────────────────────────────
# Spontaneous responses (off by default)
# ───────────────────────────────────────────────────────────────

# If true, the bot may reply without being mentioned when it detects
# certain keywords. Useful for hackathon brainstorming.
SPONTANEOUS_RESPONSE=false
SPONTANEOUS_PROBABILITY=0.3


# ───────────────────────────────────────────────────────────────
# Personality (optional override)
# ───────────────────────────────────────────────────────────────

# Override the default personality. Leave empty to use the built-in
# "Lain" persona (Argentinian Spanish, direct, no filter).
# SYSTEM_PROMPT=


# ============================================================================
# VOICE — ElevenLabs TTS + STT
# ============================================================================

# Master switch. Set to true to enable !join / !leave and voice features.
VOICE_ENABLED=false

# (Optional) Default voice channel ID. If set, !join always connects here
# regardless of where the user is. If empty, !join joins the user's current VC.
# VOICE_CHANNEL_ID=

# API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID — pick one from https://elevenlabs.io/app/voice-library
# (the ID looks like "EXAVITQu4vr4xnSDxMaL")
ELEVENLABS_VOICE_ID=your_voice_id_here

# TTS model:
#   eleven_v3              — most expressive, supports inline audio tags, slower
#   eleven_turbo_v2_5      — recommended: ~300ms latency, multilingual, natural
#   eleven_flash_v2_5      — ultra low latency ~75ms, slightly lower quality
#   eleven_multilingual_v2 — high quality, ~1-2s latency
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5

# STT model (Scribe v1)
ELEVENLABS_STT_MODEL=scribe_v1

# STT language (ISO-639-3): spa=Spanish, eng=English, por=Portuguese, etc.
VOICE_LANGUAGE=spa


# ───────────────────────────────────────────────────────────────
# Voice — behavior
# ───────────────────────────────────────────────────────────────

# Reply to anything spoken in the VC (no wake word required).
VOICE_ALWAYS_RESPOND=true

# Wake words (CSV). Only used if VOICE_ALWAYS_RESPOND=false.
VOICE_WAKE_WORDS=lain

# Drop transcripts shorter than this (filters "uh", "ah" noise).
VOICE_MIN_TURN_CHARS=3

# Min ms between two consecutive bot replies (prevents talking over itself).
VOICE_COOLDOWN_MS=1500

# Silence (ms) that closes a turn and triggers STT.
VOICE_SILENCE_MS=1000

# Force-flush a turn after this many seconds (caps very long monologues).
VOICE_MAX_TURN_SECONDS=15

# Truncate TTS responses longer than this (chars).
VOICE_MAX_RESPONSE_CHARS=600

# Recent voice turns to inject as immediate context to Claude.
VOICE_RECENT_TURNS=30

# Mirror text-channel responses to TTS while connected to VC.
VOICE_MIRROR_TEXT=false

# Auto-leave the VC after this many seconds with no audio. 0 = never.
VOICE_IDLE_TIMEOUT_SECONDS=120
VOICE_IDLE_CHECK_SECONDS=15


# ───────────────────────────────────────────────────────────────
# Voice — Claude model (independent from chat)
# ───────────────────────────────────────────────────────────────

# Model used in voice mode. Haiku is 3-5x faster than Opus and quality is
# good enough for short spoken replies. Leave empty to reuse ANTHROPIC_MODEL.
VOICE_CLAUDE_MODEL=claude-haiku-4-5

# Reasoning in voice (independent of chat — chat keeps EXTENDED_THINKING/MAX).
# Off by default for minimum latency.
VOICE_EXTENDED_THINKING=false
VOICE_THINKING_EFFORT=low

# Long-term memory budget for voice mode:
#   -1 → use MEMORY_MAX_CHARS (full memory, leverages prompt caching)
#    0 → no long-term memory in voice (fastest, less context)
#   >0 → custom char budget
VOICE_MEMORY_MAX_CHARS=-1


# ───────────────────────────────────────────────────────────────
# ElevenLabs voice_settings (how the voice sounds)
# ───────────────────────────────────────────────────────────────

# Speed: 1.0 = normal, <1 = slower, >1 = faster. 0.88–0.95 sounds natural.
VOICE_SPEED=0.92
# Stability: higher = more consistent; lower = more expressive but variable.
VOICE_STABILITY=0.5
# Similarity boost: how closely the output follows the original voice timbre.
VOICE_SIMILARITY_BOOST=0.8
# Style exaggeration: a touch of style avoids robotic delivery.
VOICE_STYLE=0.15
VOICE_USE_SPEAKER_BOOST=true
